    "stages": {
      "raw": {
        "key": "raw",
        "label": "Raw",
        "description": "The reading exactly as the monitor or its data provider reported it, before any adjustment."
      },
      "corrected": {
        "key": "corrected",
        "label": "Corrected",
        "description": "Raw readings from a monitor's two sensors checked against each other and combined into one value."
      },
      "cleaned": {
        "key": "cleaned",
        "label": "Cleaned",
        "description": "Readings with obvious errors removed or smoothed, such as impossible values and short spikes."
      },
      "calibrated": {
        "key": "calibrated",
        "label": "Calibrated",
        "description": "Readings adjusted to better match reference-grade instruments, or aggregated or computed by the data provider."
      }
    },
    "processors": {
      "AQLiteRawCleaner": {
        "key": "AQLiteRawCleaner",
        "label": "Ozone range and warm-up check",
        "description": "Discards impossible ozone readings and readings taken in the 20 minutes after the sensor restarts, while it warms up."
      },
      "AirGradientHumidity": {
        "key": "AirGradientHumidity",
        "label": "Humidity correction",
        "description": "Corrects AirGradient and PurpleAir relative humidity readings using AirGradient's published equation, capped at 100 percent."
      },
      "AirGradientTemperature": {
        "key": "AirGradientTemperature",
        "label": "Temperature correction",
        "description": "Corrects AirGradient and PurpleAir outdoor temperature readings using AirGradient's published equation; indoor monitors are skipped."
      },
      "O3_VOZBox": {
        "key": "O3_VOZBox",
        "label": "VOZBox ozone calibration",
        "description": "Adjusts raw VOZBox ozone using a fit that accounts for temperature and humidity."
      },
      "PM25_EPA_Oct2021": {
        "key": "PM25_EPA_Oct2021",
        "label": "EPA correction (Oct 2021)",
        "description": "Adjusts low-cost sensor PM2.5 using humidity, following the EPA's October 2021 PurpleAir correction for the Fire and Smoke Map."
      },
      "PM25_FEM_Cleaner": {
        "key": "PM25_FEM_Cleaner",
        "label": "Range check for reference monitors",
        "description": "Discards impossible PM2.5 readings from reference-grade monitors and sets small negative values to zero."
      },
      "PM25_LCS_Cleaning": {
        "key": "PM25_LCS_Cleaning",
        "label": "Spike cleaning",
        "description": "Replaces a sudden one-reading jump in PM2.5 with the higher of the neighboring readings when it far exceeds them."
      },
      "PM25_LCS_Correction": {
        "key": "PM25_LCS_Correction",
        "label": "Two-sensor check and blend",
        "description": "Compares a monitor's two PM2.5 sensors, drops bad or stuck readings, and averages them when they agree (or uses the lower one when they don't)."
      },
      "PM25_MultivariateLinearRegression": {
        "key": "PM25_MultivariateLinearRegression",
        "label": "Linear calibration (with weather)",
        "description": "Adjusts low-cost sensor PM2.5 using a fit to a reference monitor that also accounts for temperature and humidity."
      },
      "PM25_UnivariateLinearRegression": {
        "key": "PM25_UnivariateLinearRegression",
        "label": "Linear calibration (PM2.5 only)",
        "description": "Adjusts low-cost sensor PM2.5 with a straight-line fit built by comparing nearby sensors to a reference monitor."
      }
    }
  }
